# Isolated regression profiles and generated verification artifacts
/.tmp/

# .workflow 校验脚本的产物:每次运行 check-*.mjs 都会重新生成,不入库
/.workflow/*/preview.js
/.workflow/*/preview.css
/.workflow/*/index.html
/.workflow/*/*.png

# 本地手工安装的 Python fontTools(仅用于字体子集化),不入库
/.workflow/font-tools/
__pycache__/
*.py[cod]

# Rust 原生模块 (external-media-integration) 构建产物
# target/ 是 cargo 的输出目录，体积大且可重建
native/*/target/
native/*/Cargo.lock
# napi 产出的 .node 二进制，由 yarn build:native:emi 生成
native/*/*.node
native/*/*.d.ts
# napi 在 crate 根目录生成的 npm 元数据目录
native/*/npm/

