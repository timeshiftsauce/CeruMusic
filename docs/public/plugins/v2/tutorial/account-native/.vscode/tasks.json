{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ceru: dev",
      "type": "process",
      "isBackground": true,
      "problemMatcher": {
        "owner": "ceru",
        "pattern": {
          "regexp": "^CERU_ERROR (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^CERU_DEBUG_READY "
        }
      },
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@shiqianjiang/ceru-plugin-cli/dist/bin.js",
        "dev",
        "--ensure-running"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Ceru: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "Ceru: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
